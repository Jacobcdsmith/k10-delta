# K10-Δ configuration — copy this to .env and fill in real values.
# host.py loads these from the process environment (use `export $(cat .env | xargs)`
# or a tool like python-dotenv / direnv — nothing here auto-loads .env for you).

# ── MCP gateway (required) ──────────────────────────────────────────────
# Either set the full endpoint URL...
K10_MCP_ENDPOINT=
# ...or just the token, and host.py will build wss://api.xiaozhi.me/mcp/?token=...
K10_MCP_TOKEN=

# ── Host runtime (optional, defaults shown) ─────────────────────────────
K10_RECONNECT_WAIT=5
K10_DASHBOARD_HOST=0.0.0.0
K10_DASHBOARD_PORT=8765

# ── Device link (scripts/hermes_k10_bridge.py — TCP/WS bridge to the K10) ─
K10_WS_HOST=0.0.0.0
K10_WS_PORT=8765
K10_HTTP_PORT=8766
K10_TCP_PORT=5555

# ── GitHub tool (optional — tools/github_ns.py) ─────────────────────────
# A fine-grained personal access token (repo/issues/pull-requests scopes as
# needed). Never accepted as a tool argument — read from env only, so it
# can't leak into episodes.jsonl or the dashboard.
GITHUB_TOKEN=

# ── Voice stack (optional — local ASR/TTS bridge) ───────────────────────
VOICE_HERMES_HOME=
HERMES_API_URL=http://127.0.0.1:8642/v1
HERMES_API_KEY=k10-hermes-voice-local
HERMES_API_MODEL=hermes-agent
PIPER_VOICE=C:\piper\en_US-ryan-high.onnx
WHISPER_MODEL=base
FFMPEG=
